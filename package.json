{
  "name": "modulos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "dev:sandbox": "cross-env EXPO_PUBLIC_APP_ENV=sandbox expo start --web",
    "dev:offline": "node scripts/stub-outputs.mjs && expo start --web",
    "build": "expo export --platform web",
    "build:sandbox": "cross-env EXPO_PUBLIC_APP_ENV=sandbox expo export --platform web",
    "typecheck": "tsc --noEmit",
    "check:theme": "node scripts/check-theme.mjs",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run check:theme && npm test",
    "sandbox": "ampx sandbox",
    "sandbox:delete": "ampx sandbox delete"
  },
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@aws-amplify/rtn-web-browser": "^1.4.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "aws-amplify": "^6.18.0",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "plaid": "^43.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "^2.1.0",
    "react-native-plaid-link-sdk": "^13.4.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-plaid-link": "^5.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@opentelemetry/core": "2.9.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.23.0",
    "@aws-amplify/backend-cli": "^1.8.3",
    "@aws-sdk/client-dynamodb": "^3.1089.0",
    "@aws-sdk/lib-dynamodb": "^3.1089.0",
    "@aws-sdk/types": "^3.975.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "aws-cdk-lib": "^2.276.0",
    "constructs": "^10.8.1",
    "cross-env": "^10.1.0",
    "typescript": "~5.8.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "main": "expo-router/entry"
}
